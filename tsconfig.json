{
    "compilerOptions": {
        // File Layout
        "rootDir": "./src",
        "outDir": "./dist",
        "allowJs": true,
        "noEmit": true,
        "noImplicitAny": true,
        "strict": true,

        // Environment Settings
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "esnext",
        "types": [],

        // Other Outputs
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        // Recommended Options
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
